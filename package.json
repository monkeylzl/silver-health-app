{
  "name": "silver-health-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "dev:api": "pnpm --filter @silver-health/api dev",
    "dev:web": "pnpm --filter @silver-health/web dev",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed:demo": "node scripts/seed-demo-data.ts",
    "check:demo": "node scripts/check-demo-data.ts",
    "check:demo-copy": "node scripts/check-demo-copy.ts",
    "demo:ready": "node scripts/demo-ready.ts",
    "demo:reset": "node scripts/demo-reset.ts",
    "deploy:vercel": "node scripts/vercel-prebuilt-deploy.ts",
    "smoke:production": "node scripts/production-smoke.ts",
    "test:demo-reset-utils": "node --test scripts/demo-reset-utils.test.ts",
    "test:smoke-utils": "node --test scripts/production-smoke-utils.test.ts",
    "test:vercel-deploy-utils": "node --test scripts/vercel-deploy-utils.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.6.0",
    "turbo": "^2.5.6"
  }
}
