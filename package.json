{
  "name": "silver-health-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "dev:api": "pnpm --filter @silver-health/api dev",
    "dev:web": "pnpm --filter @silver-health/web dev",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed:demo": "node scripts/seed-demo-data.ts",
    "check:demo": "node scripts/check-demo-data.ts",
    "check:demo-copy": "node scripts/check-demo-copy.ts",
    "demo:ready": "node scripts/demo-ready.ts",
    "demo:reset": "node scripts/demo-reset.ts",
    "access-code:hash": "node scripts/hash-trial-access-code.ts",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.ts",
    "deploy:vercel": "node scripts/vercel-prebuilt-deploy.ts",
    "smoke:production": "node scripts/production-smoke.ts",
    "test:e2e:local-write": "node scripts/local-write-e2e.ts",
    "test:e2e:mobile": "playwright test --config playwright.config.ts",
    "test:e2e:app": "node scripts/local-write-e2e.ts",
    "test:demo-reset-utils": "node --test scripts/demo-reset-utils.test.ts scripts/demo-date-utils.test.ts",
    "test:github-workflow": "node --test scripts/github-workflow.test.ts",
    "test:local-e2e-utils": "node --test scripts/local-e2e-utils.test.ts",
    "test:report-generation-utils": "node --test scripts/report-generation-utils.test.ts",
    "test:smoke-utils": "node --test scripts/production-smoke-utils.test.ts",
    "test:vercel-deploy-utils": "node --test scripts/vercel-deploy-utils.test.ts",
    "test:release": "corepack pnpm prisma:generate && corepack pnpm test:unit && corepack pnpm test:demo-reset-utils && corepack pnpm test:github-workflow && corepack pnpm test:local-e2e-utils && corepack pnpm test:report-generation-utils && corepack pnpm test:smoke-utils && corepack pnpm test:vercel-deploy-utils && corepack pnpm --filter @silver-health/web typecheck && corepack pnpm --filter @silver-health/web build && corepack pnpm --filter @silver-health/api typecheck && corepack pnpm --filter @silver-health/api build && corepack pnpm test:e2e:app"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "prettier": "^3.6.2",
    "prisma": "^6.6.0",
    "turbo": "^2.5.6"
  }
}
